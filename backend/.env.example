# Salin file ini menjadi .env dan isi nilainya

# DATABASE — Railway MySQL otomatis mengisi ini
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# PORT — Railway otomatis mengisi ini
PORT=3001

# CORS origin — isi dengan URL Vercel Anda setelah deploy
FRONTEND_URL="https://nama-project.vercel.app"
